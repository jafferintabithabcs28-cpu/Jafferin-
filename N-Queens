#include <iostream>
#include <cmath>
using namespace std;

#define N 4

int x[N + 1];

bool Place(int k, int i) {
    for (int j = 1; j <= k - 1; j++) {
        if (x[j] == i || abs(x[j] - i) == abs(j - k))
            return false;
    }
    return true;
}

void NQueens(int k, int n) {
    for (int i = 1; i <= n; i++) {

        if (Place(k, i)) {
            x[k] = i;

            if (k == n) {
                cout << "Solution:\n";
                for (int row = 1; row <= n; row++) {
                    for (int col = 1; col <= n; col++) {
                        if (x[row] == col)
                            cout << "1 ";
                        else
                            cout << "0 ";
                    }
                    cout << endl;
                }
                cout << endl;
            }
            else {
                NQueens(k + 1, n);
            }
        }
    }
}
int main() {
    NQueens(1, N);
    return 0;
}
